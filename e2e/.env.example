# Optional overrides for the flow runner. Both default sensibly, so a bare run
# works with no flags.

# Absolute path to the built library (defaults to ../dist/index.js relative to e2e/).
# V0_LIB_PATH=/abs/path/to/v0-mcp-server/dist/index.js

# A valid-format v0 API key. The covered tools are network-free, so a synthetic
# format-valid key is sufficient. Defaults to a synthetic `v0_test_key_...`.
# V0_API_KEY=v0_your_key_here
